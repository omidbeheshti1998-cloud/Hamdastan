# نمونهٔ متغیرهای محیطی. برای توسعهٔ محلی از این کپی بگیر:
#   cp .env.example .env
#
# در production هیچ فایل .env داخل ایمیج نیست؛ همهٔ این‌ها باید در تنظیمات
# محیطیِ سرویس ست شوند.

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────
# NOT IMPLEMENTED — no code reads this today. Setting it changes nothing.
SKIP_AUTH=false
# Session lifetime in days (default: 7)
SESSION_MAX_AGE_DAYS=7
# HMAC key for OTP and session-token hashes. Required — the app throws without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates every session and pending code.
AUTH_SECRET=""

# ─── SMS ─────────────────────────────────────────────────────
# dev = no SMS is sent and the verification code is always 123456.
# `dev` is the only implemented value, so leaving this unset falls back to it and
# login keeps working. Any other name fails until a provider is added to
# lib/server/sms.ts. That fallback disappears on its own the moment a real
# provider lands — otherwise a missing variable in production would silently make
# every account reachable with 123456.
SMS_PROVIDER=dev

# ─── Logging ─────────────────────────────────────────────────
# NOT IMPLEMENTED — no code reads this today.
LOG_LEVEL=info
PRISMA_LOG_QUERIES=false
