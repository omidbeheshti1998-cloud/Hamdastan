# نمونهٔ متغیرهای محیطی. برای توسعهٔ محلی از این کپی بگیر:
#   cp .env.example .env
#
# در production هیچ فایل .env داخل ایمیج نیست؛ همهٔ این‌ها باید در تنظیمات
# محیطیِ سرویس ست شوند.

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────
# Set to true to bypass login entirely (no database needed) — UI development only.
SKIP_AUTH=false
# Session lifetime in days (default: 7)
SESSION_MAX_AGE_DAYS=7
# HMAC key for OTP and session-token hashes. Required — the app throws without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates every session and pending code.
AUTH_SECRET=""

# ─── SMS ─────────────────────────────────────────────────────
# dev = no SMS is sent and the verification code is always 123456.
SMS_PROVIDER=dev

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
PRISMA_LOG_QUERIES=false
